# Sao chép file này thành .deploy.env và điền đúng cấu hình SSH của VPS.
# .deploy.env đã được gitignore và chỉ cần thiết lập một lần trên máy deploy.
VPS_USER=stackops
VPS_HOST=42.1.126.80
VPS_PORT=22
VPS_DIR=/home/stackops/xbus-management

# Bỏ trống nếu SSH key mặc định (~/.ssh/id_ed25519) đã hoạt động.
VPS_SSH_KEY=

IMAGE_REPOSITORY=luongtrinh462004/xbus-office
IMAGE_TAG=latest
PUBLIC_APP_URL=https://xbus-office.xmobility.vn
