# Plane Community Edition deployment for XBus
APP_RELEASE=stable
LISTEN_HTTP_PORT=3100
LISTEN_HTTPS_PORT=3143
SITE_ADDRESS=:80

# Browser-visible URL of Plane. In production, use a dedicated HTTPS origin,
# for example https://plane.office.example.com.
WEB_URL=http://localhost:3100
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3000

POSTGRES_USER=plane
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=plane
PGDATABASE=plane
PGHOST=plane-db
PGPORT=5432
DATABASE_URL=postgresql://plane:replace-with-a-long-random-password@plane-db/plane

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=replace-with-a-long-random-password
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:replace-with-a-long-random-password@plane-mq:5672/plane

AWS_ACCESS_KEY_ID=replace-with-a-random-access-key
AWS_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
AWS_S3_BUCKET_NAME=uploads
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_REGION=
USE_MINIO=1
MINIO_ENDPOINT_SSL=0

SECRET_KEY=replace-with-at-least-50-random-characters
LIVE_SERVER_SECRET_KEY=replace-with-at-least-50-random-characters
FILE_SIZE_LIMIT=10485760
DEBUG=0
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_EMAIL=
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0
XBUS_FRAME_ANCESTORS=http://localhost:3000

# Same secret as PLANE_BRIDGE_SECRET in XBus .env.local (generate at least 32 bytes).
XBUS_BRIDGE_SECRET=replace-with-a-random-bridge-secret
