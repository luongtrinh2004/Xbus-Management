# syntax=docker/dockerfile:1.7
# Build the vendored Plane source; context is services/plane.
FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat && corepack enable
WORKDIR /app
ENV CI=true npm_config_store_dir=/pnpm/store
COPY . .
RUN --mount=type=cache,id=xbus-plane-pnpm,target=/pnpm/store CI=true pnpm install --frozen-lockfile --store-dir=/pnpm/store
ENV VITE_XBUS_EMBEDDED=true
ENV VITE_API_BASE_URL="" VITE_WEB_BASE_URL="" VITE_ADMIN_BASE_URL="" VITE_LIVE_BASE_URL="" VITE_SPACE_BASE_URL=""
ENV VITE_ADMIN_BASE_PATH=/god-mode VITE_LIVE_BASE_PATH=/live VITE_SPACE_BASE_PATH=/spaces
RUN --mount=type=cache,id=xbus-plane-pnpm,target=/pnpm/store pnpm turbo run build --filter=web

# Keep the existing static server and port expected by the XBus proxy.
FROM makeplane/plane-frontend@sha256:22fd2434fb8d6658439f669ab72f999ce0773abe587663da21a77d70bd63ff61
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/apps/web/build/client/ /usr/share/nginx/html/
